# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Environnement virtuel (recréé par `uv sync`) ---
.venv/

# --- Outils ---
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Données ---
# Données brutes téléchargées : volumineuses et re-téléchargeables, jamais versionnées.
data/raw/*
!data/raw/.gitkeep
# Données transformées (Parquet) : régénérées par les scripts.
data/processed/*
!data/processed/.gitkeep

# --- Secrets (clés d'API des futurs LLM) ---
.env
.env.*

# --- Éditeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Journaux Kaggle volumineux (re-téléchargeables) ---
experiments/blocC/kaggle_run*/ollama_*.log
experiments/blocD/kaggle_*/ollama_*.log
experiments/blocD/kaggle_*/*.log

# document de l'école, non publié (copie locale seulement)
docs/Cahier_des_charges_v3_InvestAgents.pdf

# --- Sauvegardes git (jamais dans le dépôt)
*.bundle
